# Copy to /etc/mpau/mpau.env and replace the server address before starting.
MPAU_DATA_DIR=/var/lib/mpau/data
MPAU_AGENT_INSTALLER_PATH=/var/lib/mpau/releases/MPAU-Agent-Setup.exe

MPAU_BIND_HOST=0.0.0.0
MPAU_PORT=8788
MPAU_ALLOWED_HOSTS=你的服务器地址,127.0.0.1,localhost
MPAU_ALLOWED_ORIGINS=http://你的服务器地址:8788,http://127.0.0.1:8788,http://localhost:8788

MPAU_SESSION_SECONDS=43200
# Set true only for the first remote administrator setup, then restart with false.
MPAU_ALLOW_REMOTE_BOOTSTRAP=false
MPAU_MAX_UPLOAD_REQUEST_BYTES=21474836480
MPAU_MAX_MEDIA_TOTAL_BYTES=107374182400
MPAU_MAX_MEDIA_FILES=1000
